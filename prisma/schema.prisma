datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         String     @id @default(uuid()) @db.Uuid
  legajo     String?    @unique @db.VarChar(50)
  name       String     @unique @db.VarChar(255)
  phone      String?    @db.VarChar(50)
  department String?    @default("General") @db.VarChar(100)
  schedules  Schedule[]
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employees")
}

model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  date        DateTime @db.Date
  dayName     String   @map("day_name") @db.VarChar(20)
  timeRange   String   @map("time_range") @db.VarChar(50)
  startTime   String?  @map("start_time") @db.VarChar(10) // or DateTime/Time
  endTime     String?  @map("end_time") @db.VarChar(10)
  isDayOff    Boolean  @default(false) @map("is_day_off")
  notes       String?  @db.Text
  rawOcrText  String?  @map("raw_ocr_text") @db.Text
  source      String   @default("OCR_WHATSAPP") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date], name: "employee_date_unique")
  @@index([employeeId, date])
  @@index([date])
  @@map("schedules")
}
