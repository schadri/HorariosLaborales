# PostgreSQL Database URL
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/schedules_db
# Example for Supabase/Neon/Railway: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schedules_db"

# Secret Token for n8n Webhook / Backend API Security
# Pass in Authorization header: Bearer your_secure_n8n_token_here
N8N_API_SECRET="sec_n8n_schedules_2026_x89"

# Optional: Vision AI API Keys if invoking Vision directly from the app (fallback / simulation)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Public Application URL (used for WhatsApp redirect links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
